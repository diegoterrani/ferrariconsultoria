# Copie para .env.local (dev) — nunca commitar o arquivo real.
# Dado real nunca em local ou staging (spec seção 10) — use dado sintético.

# Postgres gerenciado (Supabase). Formato: postgresql://user:pass@host:5432/db
DATABASE_URL=

# Auth.js — gerar com: npx auth secret
AUTH_SECRET=

# Provedor de magic link (Auth.js Email provider) — ex.: Resend, SMTP próprio.
EMAIL_SERVER=
EMAIL_FROM=

# Supabase Storage/client SDK — PDFs de diagnóstico, entregáveis (spec seção 2).
# Ainda sem uso no código (nenhuma integração de Storage implementada) — só
# reservado aqui pra bater com os nomes já configurados no Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API da Anthropic — módulo C1, acessada só via src/lib/ai-provider.ts.
ANTHROPIC_API_KEY=
# Opcional — default claude-sonnet-5 se não preenchida (src/lib/ai-provider.ts).
ANTHROPIC_MODEL=

# Preenchida em CI apontando para um projeto Supabase de teste/staging —
# habilita os testes obrigatórios #1 e #2 (ver tests/integration/).
DATABASE_URL_TEST=
