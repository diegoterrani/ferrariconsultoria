// Plataforma Ferrari — schema de dados
//
// Fonte: phases/f3_escopo_mvp/especificacao_plataforma_dev.md, seção 5.
// Este arquivo é o ponto de partida (as entidades que "todo o resto depende"),
// não o schema completo — o time de desenvolvimento expande os campos conforme
// cada módulo (B1, B6, C1) é implementado.
//
// Decisão de segurança que precede este arquivo (seção 4 da spec): nenhuma
// query pode depender só da aplicação para isolar por tenant. A camada
// Row-Level Security (ver supabase/migrations/0001_multi_tenant_rls.sql) é a
// rede de segurança redundante no próprio banco — este schema só declara os
// dados; quem aplica o isolamento é a policy SQL, não o Prisma Client.

// engineType "client" (driver adapters, sem binário nativo baixado) —
// decisão deliberada, não só workaround de sandbox: é o modo recomendado
// pela própria Prisma para runtime serverless/edge (Vercel, spec seção 2),
// menor cold start e sem depender de um binário Rust por plataforma.
// Requer @prisma/adapter-pg + pg (ver src/lib/db.ts) na hora de instanciar
// o client.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin // Administradora (Eliane) — acesso a todos os tenants
  staff // Colaborador da consultoria (futuro) — mesmo escopo que admin
  client_owner // Cliente (dono/gerente) — só o próprio tenant
}

enum TenantStatus {
  ativo
  risco_churn
  encerrado
}

enum DeliverableStatus {
  rascunho
  em_revisao
  aprovado
  enviado
}

enum ActivityType {
  entrega
  prospeccao
  administrativo
}

enum PipelineStage {
  contato
  reuniao
  diagnostico
  fechamento
}

/// Decisão do cliente registrada na página de resultado do diagnóstico
/// (spec seção 6.1, modal "Registrar decisão do cliente").
enum DecisaoCliente {
  aceite
  recusa
  nao_agora
}

enum InvoiceStatus {
  pendente
  pago
  atrasado
}

enum SensitiveRecordType {
  saude_ocupacional
  bancario
}

/// Um cliente da consultoria — unidade de isolamento de dados (tenant).
model Tenant {
  id               String       @id @default(uuid())
  razaoSocial      String       @map("razao_social")
  cnpj             String       @unique
  porte            String
  segmento         String
  pacoteContratado String?      @map("pacote_contratado")
  status           TenantStatus @default(ativo)
  createdAt        DateTime     @default(now()) @map("created_at")

  users         User[]
  assessments   Assessment[]
  deliverables  Deliverable[]
  timeEntries   TimeEntry[]
  pipelineLeads PipelineLead[]
  invoices      Invoice[]
  dataSubjects  DataSubject[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

/// Autenticação e escopo de acesso. tenantId nulo = admin/staff.
///
/// passwordHash: só admin/staff autenticam no MVP (spec seção 3 — cliente
/// tem portal próprio, fora desta fatia; colaborador do cliente não é
/// usuário). NOT NULL porque não existe ainda nenhuma linha client_owner —
/// quando o portal for implementado, essa constraint é revisitada, não
/// contornada com valor vazio.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  tenantId     String?  @map("tenant_id")
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  auditLogs AuditLog[]

  @@index([tenantId])
  @@map("users")
}

/// Módulo B1 — Assessment / Diagnóstico.
///
/// tenantId é NOT NULL desde o primeiro passo do wizard: a entrada
/// `/assessments/novo` cria (ou reaproveita, por CNPJ) o registro de Tenant
/// ali mesmo — "tenant" aqui é "empresa cadastrada", não necessariamente
/// cliente pagante; `pacoteContratado` continua nulo e `status` continua
/// no default `ativo` até o fechamento comercial real (spec seção 6.1 não
/// resolve isso explicitamente; esta é a decisão adotada, documentada aqui
/// em vez de um campo TenantStatus.prospect que a spec não define).
///
/// status (texto livre, spec seção 5 não enumera valores): "rascunho"
/// enquanto o wizard está em andamento (autosave por passo), "concluido"
/// depois que o score é calculado.
model Assessment {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  respostas      Json
  scoreExposicao Int?     @map("score_exposicao")
  status         String   @default("rascunho")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  pipelineLeads PipelineLead[]
  deliverables  Deliverable[]

  @@index([tenantId])
  @@map("assessments")
}

/// Módulo C1 — geração assistida por IA. `status` implementa a regra de
/// revisão humana obrigatória (spec seção 8.3): só a administradora, por ação
/// explícita, move em_revisao → aprovado; só aprovado → enviado dispara envio real.
model Deliverable {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  tipo  String
  /// Título legível (ex.: "Descrição de cargo — Cozinheiro(a)"), composto a
  /// partir do nome do template na criação — distingue múltiplos
  /// entregáveis do mesmo tipo para o mesmo tenant na listagem.
  titulo String

  /// Referência à biblioteca de templates (spec C1.1, src/lib/entregaveis/templates.ts).
  /// Não é FK de banco: a biblioteca é um array estático no código, não uma
  /// tabela — versionar o template é uma mudança de código (PR), como o
  /// motor de score do B1 (spec seção 6.1).
  templateBaseId String @map("template_base_id")

  /// Assessment de origem (spec C1.2.a: "usa as respostas de B1.1 para
  /// personalizar o rascunho"). Nulo quando o entregável é criado sem
  /// assessment associado (ex.: direto da página do cliente).
  assessmentId String?     @map("assessment_id")
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])

  conteudo    String
  status      DeliverableStatus @default(rascunho)
  geradoPorIa Boolean           @default(false) @map("gerado_por_ia")

  /// Capturado ao aprovar (spec C1.3.a): "quanto tempo você levaria para
  /// produzir isso sem a IA?" — alimenta uma futura medição de horas
  /// economizadas (C1.3.b) com dado real em vez de estimativa. Opcional:
  /// a aprovação não pode ficar bloqueada por esse dado.
  tempoManualEstimadoMinutos Int? @map("tempo_manual_estimado_minutos")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([assessmentId])
  @@map("deliverables")
}

/// Módulo B6 — controle de horas, alimenta o painel de capacidade.
model TimeEntry {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  atividade      ActivityType
  duracaoMinutos Int          @map("duracao_minutos")
  data           DateTime

  @@index([tenantId])
  @@map("time_entries")
}

/// Módulo B6 — funil comercial. tenantId nulo até o lead virar cliente.
///
/// assessmentId + decisao/motivoDecisao: preenchidos pelo modal "Registrar
/// decisão do cliente" na página de resultado do diagnóstico (spec seção
/// 6.1) — é o que a seção 6.2 chama de "link direto para o diagnóstico (B1)
/// associado" ao abrir um card do Kanban.
model PipelineLead {
  id             String          @id @default(uuid())
  tenantId       String?         @map("tenant_id")
  tenant         Tenant?         @relation(fields: [tenantId], references: [id])
  estagio        PipelineStage   @default(contato)
  assessmentId   String?         @map("assessment_id")
  assessment     Assessment?     @relation(fields: [assessmentId], references: [id])
  decisao        DecisaoCliente?
  motivoDecisao  String?         @map("motivo_decisao")
  pacoteSugerido String?         @map("pacote_sugerido")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([assessmentId])
  @@map("pipeline_leads")
}

/// Módulo B6 — faturamento. Sem gateway de pagamento no MVP (spec seção 7):
/// cobrança registrada e marcada manualmente.
model Invoice {
  id         String        @id @default(uuid())
  tenantId   String        @map("tenant_id")
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  competencia String
  valor      Decimal       @db.Decimal(10, 2)
  status     InvoiceStatus @default(pendente)

  @@index([tenantId])
  @@map("invoices")
}

/// Colaboradores do cliente — titulares de dado (LGPD), não usuários do
/// sistema no MVP (spec seção 3). Nenhum dado pode existir sem consentimento
/// registrado primeiro (seção 8.5) — ver constraint em migration futura.
model DataSubject {
  id                        String    @id @default(uuid())
  tenantId                  String    @map("tenant_id")
  tenant                    Tenant    @relation(fields: [tenantId], references: [id])
  nome                      String
  cpfCriptografado          String    @map("cpf_criptografado")
  consentimentoRegistradoEm DateTime? @map("consentimento_registrado_em")

  sensitiveRecords SensitiveRecord[]

  @@index([tenantId])
  @@map("data_subjects")
}

/// Tabela separada e mais restrita que data_subjects (spec seção 8.1) —
/// nunca uma coluna a mais no cadastro. Toda leitura grava em audit_log,
/// sem exceção, mesmo pela administradora.
model SensitiveRecord {
  id                String              @id @default(uuid())
  dataSubjectId     String              @map("data_subject_id")
  dataSubject       DataSubject         @relation(fields: [dataSubjectId], references: [id])
  tipo              SensitiveRecordType
  conteudoCriptografado String           @map("conteudo_criptografado")
  createdAt         DateTime            @default(now()) @map("created_at")

  @@map("sensitive_records")
}

/// Módulo B6 — capacidade semanal configurável (spec seção 6.2: "não deve
/// ser hardcoded"). Singleton: id fixo 'default', reforçado por CHECK no
/// banco (migration 0004) — nunca uma segunda linha. Sem tenantId: é
/// configuração interna da consultoria, não dado de cliente.
model CapacitySettings {
  id             String   @id @default("default")
  horasPorSemana Int      @default(10) @map("horas_por_semana")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("capacity_settings")
}

/// Toda leitura/edição/exportação de SensitiveRecord grava aqui sem exceção
/// (spec seção 8.1) — é a evidência de conformidade, não uma tabela opcional.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  acao       String
  entidade   String
  entidadeId String   @map("entidade_id")
  timestamp  DateTime @default(now())

  @@index([tenantId])
  @@map("audit_log")
}
